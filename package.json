{
  "name": "parcours-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parcours RAG — atelier ALLiaNCE. Starter Mastra + Albert API pour construire un RAG sur le corpus ANSSI « Les Essentiels ».",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "rag:doctor": "tsx src/mastra/rag/doctor.ts",
    "rag:build-chunks": "tsx src/mastra/rag/build-chunks.ts",
    "rag:build-index": "tsx src/mastra/rag/build-index.ts",
    "rag:test-retrieval": "tsx src/mastra/rag/test-retrieval.ts",
    "rag:test-agent": "tsx src/mastra/rag/test-agent.ts",
    "rag:workflow": "tsx src/mastra/rag/workflow-rag.ts",
    "rag:run-eval": "tsx src/mastra/rag/run-eval.ts",
    "rag:write-findings": "tsx src/mastra/rag/write-findings.ts",
    "slides:dev": "slidev slides/module-3.md",
    "slides:build": "slidev build slides/module-3.md --out dist/module-3",
    "slides:facilitator:dev": "slidev slides/module-3-facilitator.md",
    "slides:facilitator:build": "slidev build slides/module-3-facilitator.md --out dist/module-3-facilitator",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "security:scan:js": "cve-lite . --fail-on high",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/provider": "^3.0.10",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/rag": "^2.2.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@slidev/cli": "^52.16.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/node": "^25.9.2",
    "cve-lite-cli": "1.18.1",
    "dotenv": "^17.4.2",
    "husky": "^9.0.0",
    "mastra": "latest",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.34.1",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2"
    }
  }
}
